apiVersion: argoproj.io/v1alpha1
kind: Application

metadata:
  name: skillpulse
  namespace: argocd

spec:
  project: default

  source:
    repoURL: "{{ gitops_repo_url }}"
    targetRevision: "{{ gitops_branch }}"
    path: "{{ gitops_path }}"

  destination:
    server: https://kubernetes.default.svc
    namespace: "{{ skillpulse_namespace }}"

  syncPolicy:
    automated:
      prune: true
      selfHeal: true

    syncOptions:
      - CreateNamespace=true